import Lean.Data.Json
import Std.Data.HashSet
import Go2Lean.Dialect.GoSSA
import Go2Lean.Dialect.GoConc
import Go2Lean.Hang

/-!
# Counterexample search driver

M2's cheapest engine: seeded random testing of a property over a `GoSSA`
program, printing a JSON counterexample to stdout. The Go side generates a
small file that imports a model and calls `Search.run`.

The havoc oracle is derived from the seed, so a counterexample is
reproducible; the values actually consumed are reported from the run log.
-/
namespace Go2Lean.Search

open Go2Lean.SSA Go2Lean.GoSSA Lean

/-- How to generate one Go parameter. Mirrors `contract.ABIParam`. -/
inductive Gen where
  | int (name : String) (w : Nat) (signed : Bool)
  | bool (name : String)
  /-- An opaque `error` parameter: nil or non-nil. -/
  | err (name : String)
  /-- Slice of `w`-bit integers; `maxLen` bounds the generated length. -/
  | slice (name : String) (w : Nat) (signed : Bool) (maxLen : Nat)
  /-- Slice whose elements come from `elem` (structs, strings, pointers,
  nested slices); always materialised on the heap. -/
  | sliceOf (name : String) (elem : Gen) (maxLen : Nat)
  /-- A struct value with the given field generators. -/
  | structv (name : String) (fields : List Gen)
  /-- A pointer: a fresh heap object generated by `pointee`; nil only when
  the depth budget is spent or nil inputs are allowed. -/
  | ptr (name : String) (pointee : Gen)
  /-- A back-edge of a recursive type (`Next *Node` inside `Node`): nil
  with some probability at every depth, so structures of every length
  occur. The Go side tells the two apart from the ABI path. -/
  | link (name : String) (pointee : Gen)
  /-- A string of up to `maxLen` bytes, drawn from the literal pool or a
  small alphabet; for a named string type, mostly one of the constants
  `enum` declared for it. -/
  | str (name : String) (maxLen : Nat) (enum : List (List Nat))
  /-- A pointer that is always nil (kept for ABI records that have no type
  table). -/
  | nilptr (name : String)
  /-- A struct of the named type `tyIdx` in the type table: the way a
  recursive type refers to itself. Generation stops at the depth budget. -/
  | ref (name : String) (tyIdx : Nat)
  /-- A value the model does not look into (interface, map, func, chan,
  float): always `v`, which is `.opaqueNil` when M3 passes nil (the zero
  value of a func, map, channel or interface), a non-nil marker for a
  context (M3 passes `context.Background()`), else `.unit`. -/
  | opaque (name : String) (v : Val)
  /-- A fixed-size array of `n` elements from `elem`. -/
  | arrOf (name : String) (elem : Gen) (n : Nat)
  /-- A map of up to `maxLen` entries with keys from `key` (distinct) and
  values from `val`, built as the program builds maps (`.boxed 1 p`); nil
  when nil inputs are allowed. -/
  | mapOf (name : String) (key val : Gen) (maxLen : Nat)
  /-- An empty interface: nil, or the value of one of `alts` boxed with its
  type tag. -/
  | anyOf (name : String) (alts : List (Nat × Gen))
  /-- The raw JSON of an SDK response type (behind `RawJSON()`): empty, or
  an object of one or two members, keys from `keys`, values null, a bool,
  0, an empty string or a string from `vals`. -/
  | jsonText (name : String) (keys vals : List (List Nat))
  /-- An SDK response value (entry `desc` of the package's JSON table): a
  value from `inner`, then written as the JSON document the harness
  builds for it and decoded, so its typed fields, raw JSON and metadata
  agree as they do in Go, where such values only come from decoding. -/
  | sdkDoc (name : String) (t : GoSSA.JTable) (desc : Nat) (inner : Gen)
  /-- A union variant field the code under test reads: chosen as the live
  variant more often than the others. -/
  | hot (inner : Gen)

/-- The type table: field generators per named struct type. -/
abbrev TypeTable := Array (List Gen)

/-- The property shape to check. -/
inductive Property where
  | noPanic (f : FuncId)
  /-- `spec` takes the arguments of `f` followed by its result and returns a bool. -/
  | postcondition (f spec : FuncId)
  /-- `f` (a `go2lean:sequence` spec) returns true without panicking: it
  drives its target over an input event sequence, checks an invariant after
  each step and a condition at the end of the stream. -/
  | sequence (f : FuncId)
  /-- `f` returns on every input (#86): no run comes back to a state it was
  in (`Hang.lasso`, rerun when a run ends out of fuel). -/
  | noHang (f : FuncId)

def Property.isNoHang : Property → Bool
  | .noHang _ => true
  | _ => false

inductive Outcome where
  | holds
  | violated
  | panicked (k : PanicKind)
  | specPanicked (k : PanicKind)
  /-- The spec returned false after reading havoc: unknown, not a refutation. -/
  | specUnknown
  | outOfFuel
  /-- The run came back to a state at this loop: it never ends. -/
  | hangs (site : String)
  deriving Repr

-- Generation -----------------------------------------------------------------

/-- Boundary values a random search should hit far more often than chance would. -/
def specials (w : Nat) : Array (BitVec w) :=
  #[0#w, 1#w, -1#w, BitVec.intMin w, BitVec.intMax w, BitVec.intMax w - 1#w, BitVec.intMin w + 1#w]

/-- A value profile biases every value of one trial the same way, so that
inputs that must be correlated to trigger a bug (several large elements, all
small indices) are reached far sooner than by independent sampling. -/
inductive Profile where
  | boundary -- only `specials`
  | small    -- magnitudes up to 8
  | mixed    -- 40% specials, otherwise uniform
  deriving Repr

def Profile.ofNat : Nat → Profile
  | 0 => .boundary
  | 1 => .small
  | _ => .mixed

/-- Literals mined from the program, with their off-by-one neighbours, as
`w`-bit values. These join the boundary values so that comparisons against
magic constants are reachable by random search. -/
def mined (w : Nat) (extra : List Nat) : Array (BitVec w) :=
  (extra.flatMap fun c => [BitVec.ofNat w c, BitVec.ofNat w c - 1#w, BitVec.ofNat w c + 1#w]).toArray

def genBits (pf : Profile) (extra : List Nat) (g : StdGen) (w : Nat) : BitVec w × StdGen :=
  let (pick, g) := randNat g 0 9
  let pool := specials w ++ mined w extra
  let special (g : StdGen) :=
    let (i, g) := randNat g 0 pool.size.pred
    (pool[i]!, g)
  match pf with
  | .boundary => special g
  | .small =>
    let (n, g) := randNat g 0 16
    (BitVec.ofInt w (Int.ofNat n - 8), g)
  | .mixed =>
    if pick < 4 then special g
    else
      let (n, g) := randNat g 0 (2 ^ w - 1)
      (BitVec.ofNat w n, g)

/-- Decimal renderings of the mined integers and their neighbours, plus a
few boundary numbers, as byte strings. -/
def numberStrs (extra : List Nat) : List (List Nat) :=
  let fixed : List Int := [0, 1, -1, 255, 256, 65535, 65536, 2147483648, 9223372036854775807, 9223372036854775808]
  let mined : List Int := extra.flatMap fun (c : Nat) => [(c : Int), (c : Int) + 1, (c : Int) - 1]
  ((fixed ++ mined).map fun (v : Int) => itoaBytes v).eraseDups

/-- Bytes a random string is built from: letters, digits and the
punctuation that parsers branch on, and the characters encoders treat
specially (`"`, `\`, `<`, `&`, tab: JSON's and HTML's escapes). -/
def alphabet : Array Nat := #[97, 98, 99, 65, 66, 48, 49, 57, 32, 45, 95, 46, 47, 58, 61, 44, 10, 34, 92, 60, 38, 9]

/-- The depth budget a top-level argument starts with. -/
def topDepth : Nat := 4

/-- The depth the exhaustive engine starts at (its domains stay small). -/
def enumTop : Nat := 2

/-- The field name a generator stands for. -/
def Gen.name : Gen → String
  | .hot inner => inner.name
  | .int n .. | .bool n | .err n | .slice n .. | .sliceOf n .. | .structv n _ | .ptr n _
  | .link n _ | .str n .. | .nilptr n | .ref n _ | .opaque n _ | .arrOf n .. | .mapOf n .. | .anyOf n _
  | .jsonText n .. | .sdkDoc n .. => n

/-- The SDKs of OpenAI and Anthropic spell a union as a struct whose
fields are all named `Of<Variant>` (pointers, slices, `param.Opt` values):
exactly one is set. -/
def Gen.isVariant (g : Gen) : Bool :=
  let n := g.name
  n.startsWith "Of" && ((n.drop 2).front.isUpper)

/-- The number of `Of<Variant>` fields; two or more make a union. -/
def variantCount (fields : List Gen) : Nat := (fields.filter Gen.isVariant).length

/-- A generator of the zero value of `g`'s type: nil pointers and slices,
zero numbers, empty strings, structs of zero fields. -/
partial def zeroGen (table : TypeTable) : Gen → Gen
  | .ptr n _ | .link n _ => .nilptr n
  | .slice n .. | .sliceOf n .. => .opaque n (.slice 0 0#64 0#64 0#64)
  | .int n w _ => .opaque n (.int w 0)
  | .bool n => .opaque n (.bool false)
  | .err n => .opaque n (.err false)
  | .str n .. => .str n 0 []
  | .structv n fs => .structv n (fs.map (zeroGen table))
  | .mapOf n .. | .anyOf n _ => .opaque n .opaqueNil
  | .jsonText n .. => .str n 0 []
  -- A zero value is a literal in Go too (no raw JSON): not normalised.
  | .sdkDoc _ _ _ inner | .hot inner => zeroGen table inner
  | .ref n idx =>
    match table[idx]? with
    | some fs => .structv n (fs.map (zeroGen table))
    | none => .ref n idx
  | g => g

/-- The fields of a union with only its `k`-th variant live: the other
variants take their zero values. -/
def selectVariant (table : TypeTable) (fields : List Gen) (k : Nat) : List Gen :=
  let rec go (fs : List Gen) (i : Nat) : List Gen :=
    match fs with
    | [] => []
    | f :: rest =>
      if f.isVariant then
        (if i == k then f else zeroGen table f) :: go rest (i + 1)
      else f :: go rest i
  go fields 0

/-- The field generators of a struct, with one union variant chosen at
random when the struct is a union. -/
def chooseFields (table : TypeTable) (g : StdGen) (fields : List Gen) : List Gen × StdGen :=
  let n := variantCount fields
  if n ≥ 2 then
    -- Three times in four one of the variants the code reads, when it
    -- reads some but not all.
    let vars := fields.filter Gen.isVariant
    let hot := (List.range vars.length).filter fun i => match vars[i]? with | some (.hot _) => true | _ => false
    let (roll, g) := randNat g 0 3
    let (k, g) :=
      if roll < 3 && !hot.isEmpty && hot.length < n then
        let (j, g) := randNat g 0 (hot.length - 1)
        (hot[j]!, g)
      else randNat g 0 (n - 1)
    (selectVariant table fields k, g)
  else (fields, g)

/-- `bs` as a JSON string literal (quotes, backslash and control
characters escaped). -/
def jsonQuote (bs : List Nat) : List Nat :=
  let hex (d : Nat) : Nat := if d < 10 then 48 + d else 87 + d
  [34] ++ bs.flatMap (fun b =>
    if b == 34 then [92, 34] else if b == 92 then [92, 92]
    else if b < 32 then [92, 117, 48, 48, hex (b / 16), hex (b % 16)] else [b]) ++ [34]

/-- The JSON values a generated member takes: null, true, false, 0, "",
and the given strings. -/
def jsonValues (vals : List (List Nat)) : List (List Nat) :=
  ["null".toUTF8.toList.map (·.toNat), "true".toUTF8.toList.map (·.toNat),
   "false".toUTF8.toList.map (·.toNat), [48], [34, 34]] ++ vals.map jsonQuote

/-- `{"k1":v1,...}` -/
def jsonObject (members : List (List Nat × List Nat)) : List Nat :=
  [123] ++ ((members.map fun (k, v) => jsonQuote k ++ [58] ++ v).intersperse [44]).flatten ++ [125]

/-- An SDK response type's JSON metadata keeps, in `ExtraFields`, a
`respjson.Field` for each member of its raw JSON that no typed field
reads; decoding sets it, so a generated metadata struct derives it from
its generated raw text (nil when there is none, as the SDK leaves it). -/
def deriveExtraFields (heap : Heap Val) (fields : List Gen) (vs : List Val) : List Val × Heap Val :=
  let ri := fields.findIdx? fun | .jsonText .. => true | _ => false
  let ei := fields.findIdx? fun g => g.name == "ExtraFields"
  match ri, ei with
  | some ri, some ei =>
    match vs[ri]? >>= strBytes heap with
    | some bs =>
      match String.fromUTF8? (ByteArray.mk (bs.map UInt8.ofNat).toArray) >>= (Lean.Json.parse · |>.toOption) with
      | some (.obj _) =>
        -- Members a typed field reads are not extra: the metadata struct
        -- names those fields (ToolCalls for tool_calls).
        let norm (s : String) : String := (s.toList.filter (· != '_')).asString.toLower
        let typed := fields.map fun g => norm g.name
        let members := (jObjMembers (jTrim bs)).filter fun (k, _) => !typed.contains (norm k)
        if members.isEmpty then (vs, heap) else
        -- As apijson records an extra member: invalid unless null.
        let (es, heap) := members.foldl (fun (acc, heap) (k, src) =>
          let (kv, heap) := strAlloc heap (k.toUTF8.toList.map (·.toNat))
          let (f, heap) := respField heap (if src == asciiBytes "null" then 1 else 2) src
          (acc ++ [(kv, f)], heap)) ([], heap)
        let (p, heap) := heapAlloc heap (mapObj es)
        (vs.set ei (.boxed 1 p), heap)
      | _ => (vs, heap)
    | none => (vs, heap)
  | _, _ => (vs, heap)

/-- Generate one value. Slices and pointees are materialised on the heap,
so stores through them are exact and the report can dump them. -/
partial def genVal (pf : Profile) (extra : List Nat) (g : StdGen) (heap : Heap Val)
    (pool : List (List Nat) := []) (table : TypeTable := #[]) (depth : Nat := topDepth)
    (allowNil : Bool := true) : Gen → Val × StdGen × Heap Val
  | .int _ w _ =>
    let (v, g) := genBits pf extra g w
    (.int w v, g, heap)
  | .bool _ =>
    let (b, g) := randBool g
    (.bool b, g, heap)
  | .err _ =>
    let (b, g) := randBool g
    (.err b, g, heap)
  | .slice _ w _ maxLen =>
    -- A byte slice (json.RawMessage, a request body) is one of the pool's
    -- strings a third of the time: random bytes are almost never the JSON
    -- or text the code parses.
    let (roll, g) := randNat g 0 2
    if w == 8 && roll == 0 && !pool.isEmpty then
      -- Half of those a JSON object or array of the pool, when it has
      -- some: a json.RawMessage holds JSON.
      let docs := pool.filter fun bs => bs.head? == some 123 || bs.head? == some 91
      let (half, g) := randNat g 0 1
      let from_ := if half == 0 && !docs.isEmpty then docs else pool
      let (i, g) := randNat g 0 (from_.length - 1)
      let bs := from_[i]!
      let (p, heap) := heapAlloc heap (.arr (bs.map fun b => .int 8 (BitVec.ofNat 8 b)))
      match p with
      | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 bs.length) (BitVec.ofNat 64 bs.length), g, heap)
      | _ => (.unit, g, heap)
    else
    let (len, g) := randNat g 0 maxLen
    let (extraCap, g) := randNat g 0 2
    let (elems, g) := genMany pf extra g w (len + extraCap)
    let (p, heap) := heapAlloc heap (.arr elems)
    match p with
    | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 (len + extraCap)), g, heap)
    | _ => (.unit, g, heap)
  | .sliceOf _ elem maxLen =>
    -- Nested slices halve their length bound per level, so a struct of
    -- slices of structs of slices stays a few hundred objects per trial
    -- instead of growing exponentially.
    -- At depth zero the slice is empty: `depth - 1` would stay zero and a
    -- union whose variant holds a slice of itself would recurse forever.
    let maxLen := if depth == 0 then 0 else if depth ≥ topDepth then maxLen else max (min maxLen 1) (maxLen / 2 ^ (topDepth - depth))
    let (len, g) := randNat g 0 maxLen
    let (extraCap, g) := if maxLen == 0 then (0, g) else randNat g 0 2
    let (elems, g, heap) := genList pf extra g heap pool table (depth - 1) allowNil (List.replicate (len + extraCap) elem)
    let (p, heap) := heapAlloc heap (.arr elems)
    match p with
    | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 (len + extraCap)), g, heap)
    | _ => (.unit, g, heap)
  | .structv _ fields =>
    let (fields, g) := chooseFields table g fields
    let (vs, g, heap) := genList pf extra g heap pool table depth allowNil fields
    let (vs, heap) := deriveExtraFields heap fields vs
    (.structv vs, g, heap)
  | .ptr name pointee =>
    -- With `allowNil` off (the default) a pointer is nil only once the
    -- depth budget is spent: "a field was never set" findings drown the
    -- ones people act on. With it on: nil one time in five, more often as
    -- the budget runs out. The live variant of a union (`OfUser
    -- *UserMessage`) costs no depth: it is how the SDKs spell one value,
    -- and charging it left nested content parts and tool schemas empty.
    let variant := (Gen.ptr name pointee).isVariant
    let (roll, g) := randNat g 0 4
    if (depth == 0 && !variant) || (allowNil && roll < (if depth ≤ 1 then 3 else 1)) then (.ptr 0 [], g, heap)
    else
      let (obj, g, heap) := genVal pf extra g heap pool table (if variant then depth else depth - 1) allowNil pointee
      let (p, heap) := heapAlloc heap obj
      (p, g, heap)
  | .link _ pointee =>
    let (roll, g) := randNat g 0 4
    if depth == 0 || roll < (if depth ≤ 1 then 3 else 1) then (.ptr 0 [], g, heap)
    else
      let (obj, g, heap) := genVal pf extra g heap pool table (depth - 1) allowNil pointee
      let (p, heap) := heapAlloc heap obj
      (p, g, heap)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields =>
      let (fields, g) := chooseFields table g fields
      let (vs, g, heap) := genList pf extra g heap pool table depth allowNil fields
      let (vs, heap) := deriveExtraFields heap fields vs
      (.structv vs, g, heap)
    | none => (.unit, g, heap)
  | .nilptr _ => (.ptr 0 [], g, heap)
  | .opaque _ v => (v, g, heap)
  | .mapOf name key val maxLen =>
    -- Like a slice: halved bounds per level, empty at depth zero. Keys
    -- equal to an earlier one are dropped (a map holds each once).
    let maxLen := if depth == 0 then 0 else if depth ≥ topDepth then maxLen else max (min maxLen 1) (maxLen / 2 ^ (topDepth - depth))
    -- Nil one time in five. Below the top an exported field's map is nil
    -- even without allowNil: a field the client left out decodes as a nil
    -- map, and reading one is safe in Go (no trivial counterexample, as a
    -- nil pointer would be), while writing into one is a real bug. An
    -- unexported map is state a constructor makes: it keeps the policy.
    let (roll, g) := randNat g 0 4
    if (allowNil || (depth < topDepth && !name.front.isLower)) && roll == 0 then (.opaqueNil, g, heap) else
    let (len, g) := randNat g 0 maxLen
    let (entries, g, heap) := (List.range len).foldl (fun (acc, g, heap) _ =>
      let (k, g, heap) := genVal pf extra g heap pool table (depth - 1) allowNil key
      let (v, g, heap) := genVal pf extra g heap pool table (depth - 1) allowNil val
      if acc.any (fun (k', _) => keyEq heap k k') then (acc, g, heap) else (acc ++ [(k, v)], g, heap))
      (([] : List (Val × Val)), g, heap)
    let (p, heap) := heapAlloc heap (mapObj entries)
    (.boxed 1 p, g, heap)
  | .anyOf _ alts =>
    -- nil one time in (alternatives + 1); at depth zero only scalars, so
    -- an interface holding a map of interfaces bottoms out.
    let alts := if depth == 0 then alts.filter (fun (_, a) => match a with | .mapOf .. | .sliceOf .. => false | _ => true) else alts
    let (i, g) := randNat g 0 alts.length
    match alts[i]? with
    | none => (.opaqueNil, g, heap)
    | some (tag, a) =>
      -- The interface itself costs no depth: its map or slice does.
      let (v, g, heap) := genVal pf extra g heap pool table depth allowNil a
      (.boxed tag v, g, heap)
  | .jsonText _ keys vals =>
    -- Empty half the time (the typed fields alone); otherwise one or two
    -- members.
    let (roll, g) := randNat g 0 1
    if roll == 0 || keys.isEmpty then let (v, heap) := strAlloc heap []; (v, g, heap) else
    let values := jsonValues vals
    let (n, g) := randNat g 1 2
    let (members, g) := (List.range n).foldl (fun (acc, g) _ =>
      let (i, g) := randNat g 0 (keys.length - 1)
      let (j, g) := randNat g 0 (values.length - 1)
      (acc ++ [(keys[i]!, values[j]!)], g)) ([], g)
    let (v, heap) := strAlloc heap (jsonObject members)
    (v, g, heap)
  | .hot inner => genVal pf extra g heap pool table depth allowNil inner
  | .sdkDoc _ t d inner =>
    let (v, g, heap) := genVal pf extra g heap pool table depth allowNil inner
    match sdkNormalize t d heap v with
    | some (v, heap) => (v, g, heap)
    | none => (v, g, heap)
  | .arrOf _ elem n =>
    -- Below the budget an array holds zero values of its element kind:
    -- the generator for the element at depth zero yields nil pointers and
    -- empty slices, so the recursion ends there.
    let (elems, g, heap) := genList pf extra g heap pool table (depth - 1) allowNil (List.replicate n elem)
    (.arr elems, g, heap)
  | .str _ maxLen enum =>
    -- A named string type: one of its constants three times in four.
    -- Otherwise half the time a pool literal or a neighbour of one (a byte
    -- dropped or added, a mined integer appended: "port:" ++ "65536"), else
    -- random bytes, which are plain digits one time in four. A bound of
    -- zero pins the string to empty (a strings.Builder parameter).
    let numbers := numberStrs extra
    let (pick, g) := randNat g 0 3
    let (fromEnum, g) := randNat g 0 3
    let (bs, g) :=
      if maxLen == 0 then ([], g)
      else if fromEnum < 3 && !enum.isEmpty then
        let (i, g) := randNat g 0 (enum.length - 1)
        (enum[i]!, g)
      else if pick < 2 && !pool.isEmpty then
        let (i, g) := randNat g 0 (pool.length - 1)
        let base := pool[i]!
        let (variant, g) := randNat g 0 7
        -- JSON texts (`{...}`, `[...]`) stay whole: a mangled one is just
        -- a syntax error.
        let variant := if base.head? == some 123 || base.head? == some 91 then 7 else variant
        match variant with
        | 0 => (base.dropLast, g)
        | 1 => (base ++ [120], g)
        | 2 => (32 :: base, g)
        | 3 | 4 =>
          let (j, g) := randNat g 0 (numbers.length - 1)
          (base ++ numbers[j]!, g)
        | _ => (base, g)
      else
        let (digits, g) := randNat g 0 3
        if digits == 0 then
          let (j, g) := randNat g 0 (numbers.length - 1)
          (numbers[j]!, g)
        else
          let (len, g) := randNat g 0 maxLen
          (List.range len).foldl (fun (acc, g) _ =>
            let (i, g) := randNat g 0 (alphabet.size - 1)
            (acc ++ [alphabet[i]!], g)) ([], g)
    let (v, heap) := strAlloc heap bs
    (v, g, heap)
where
  genMany (pf : Profile) (extra : List Nat) (g : StdGen) (w n : Nat) : List Val × StdGen :=
    (List.range n).foldl (fun (acc, g) _ => let (v, g) := genBits pf extra g w; (acc ++ [.int w v], g)) ([], g)
  -- A loop, not a recursion: a struct can have thousands of leaves.
  genList (pf : Profile) (extra : List Nat) (g : StdGen) (heap : Heap Val) (pool : List (List Nat))
      (table : TypeTable) (depth : Nat) (allowNil : Bool) (gens : List Gen) : List Val × StdGen × Heap Val :=
    let (acc, g, heap) := gens.foldl (fun (acc, g, heap) gen =>
      let (v, g, heap) := genVal pf extra g heap pool table depth allowNil gen
      (v :: acc, g, heap)) (([] : List Val), g, heap)
    (acc.reverse, g, heap)

/-- Two parameters a call can receive equal values for: integers of one
width and signedness, strings of one kind. -/
def sameKind : Gen → Gen → Bool
  | .int _ w s, .int _ w' s' => w == w' && s == s'
  | .str _ m e, .str _ m' e' => m == m' && e == e'
  | _, _ => false

/-- The call's arguments, their objects allocated on `base`. One time in
four, two parameters of the same kind get the same value: equal arguments
are a classic edge case (two appends of one label set, evaluation 7's
k016), which independent draws almost never produce for strings (#87). -/
def genArgs (pf : Profile) (extra : List Nat) (g : StdGen) (gens : List Gen) (pool : List (List Nat) := [])
    (table : TypeTable := #[]) (allowNil : Bool := true) (base : Heap Val := #[]) : List Val × StdGen × Heap Val :=
  let (args, g, heap) := genVal.genList pf extra g base pool table topDepth allowNil gens
  let pairs := (List.range gens.length).flatMap fun i =>
    ((List.range gens.length).filter fun j => i < j &&
      match gens[i]?, gens[j]? with
      | some a, some b => sameKind a b
      | _, _ => false).map (i, ·)
  let (dup, g) := randNat g 0 3
  if dup != 0 || pairs.isEmpty then (args, g, heap) else
  let (k, g) := randNat g 0 (pairs.length - 1)
  let (i, j) := pairs[k]!
  (args.set j args[i]!, g, heap)

/-- Memory contents derived from a per-trial seed and profile. -/
def oracleOf (pf : Profile) (extra : List Nat) (seed : Nat) : Oracle :=
  { mem := fun ref idx =>
      let h := mixHash (mixHash (UInt64.ofNat (seed + 7)) (UInt64.ofNat ref)) (UInt64.ofNat idx.toNat)
      (genBits pf extra (mkStdGen h.toNat) 64).1 }

/-- A havoc oracle derived from the seed. Site widths encode the kind of
value: 0 is an opaque `error` (nil or non-nil), 1 is a bool, 2 is a string
(the empty string: havoc strings carry no bytes until a heap is available
to the oracle), anything else is an integer of that width. -/
def havocOf (seed : Nat) (widths : Array Nat) : Havoc Val := fun site iter =>
  let w := widths[site]?.getD 64
  let h := mixHash (mixHash (UInt64.ofNat seed) (UInt64.ofNat site)) (UInt64.ofNat (iter + 1))
  let g := mkStdGen h.toNat
  if w == 0 then .err (randBool g).1
  else if w == 1 then .bool (randBool g).1
  else if w == 2 then .str 0 0#64 0#64
  else if w == 3 then .unit -- an assumption marker: the value is not used
  else
    let (v, _) := genBits .mixed [] g w
    .int w v

-- Checking -------------------------------------------------------------------

/-- For a trial that ran out of fuel: the loop its target never leaves
(#86), found by rerunning it with the state watched at back edges. Only a
sequential target: the concurrent machine draws a schedule choice at every
step, so its states do not repeat. -/
def lassoOf (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val) (snap : Option GoConc.Snap := none) : Option Hang.Loop :=
  let f := match prop with
    | .noPanic f => f
    | .postcondition f _ => f
    | .sequence f => f
    | .noHang f => f
  match p.funcs[f]? with
  | some fn => if fn.sync then Hang.lassoConc p or h f args fuel heap snap else Hang.lasso p or h f args fuel heap
  | none => none

/-- Out-of-fuel trials rerun to look for a loop: each rerun costs as much
as the trial. -/
def lassoLimit : Nat := 20

/-- The report's fields on the out-of-fuel runs whose fuel ran out inside
one goroutine step (a loop without a scheduling point), by where the step
started. -/
def stepFuelFields (sites : List (String × Nat)) : List (String × Json) :=
  if sites.isEmpty then [] else
  [("out_of_fuel_in_step", ((sites.map (·.2)).sum : Nat)),
   ("fuel_step_sites", Json.mkObj ((sites.take 5).map fun (site, n) =>
     ((site.drop "out of fuel in a goroutine step from ".length).toString, (n : Json))))]

/-- The report's fields on loops that never end. -/
def loopFields (checked loops : Nat) (sites : List (String × Nat)) : List (String × Json) :=
  if checked == 0 then [] else
  [("loops_checked", checked), ("loops_forever", loops),
   ("loop_sites", Json.mkObj ((sites.take 5).map fun (site, n) => (site, (n : Json))))]


def check (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val := #[]) (alts : List (Havoc Val) := []) (snap : Option GoConc.Snap := none) :
    Outcome × HState Val × Option Val :=
  match prop with
  | .noPanic f =>
    match GoConc.runAny p or h f args fuel heap with
    | (.ok v, s) => (.holds, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) => (.outOfFuel, s, none)
  | .postcondition f spec =>
    match GoConc.runAny p or h f args fuel heap with
    | (.ok v, s) =>
      -- A spec takes every result of the target after its parameters.
      let results := match v with | .tuple vs => vs | v => [v]
      let before := s.log.size
      match runFunc p or h false spec (args ++ results) s fuel with
      -- A verdict that read a havoc value (the spec compared opaque values,
      -- or called something unmodelled) is neither a refutation nor support,
      -- unless the spec gives the same verdict when rerun from the same
      -- state under each of the other havoc assignments `alts`: then the
      -- havoc it read did not decide it (the trial stays havoc-dependent).
      | (.ok (.bool b), s') =>
        let decided := !alts.isEmpty && alts.all fun h' =>
          match runFunc p or h' false spec (args ++ results) s fuel with
          | (.ok (.bool b'), _) => b' == b
          | _ => false
        -- An assumed value (an unmodelled result taken as zero) is the same
        -- under every havoc assignment, so agreement says nothing about it.
        -- A havoc string is always "" (the havoc oracle has no heap to put
        -- other strings in), so it is a fixed guess like an assumption.
        let assumedAt := (s'.log.toList.drop before).find? fun (site, _, _) =>
          p.havocWidths[site]? == some 3 || p.havocWidths[site]? == some 2
        -- Name the first assumption read, for the engines' moot report.
        let s' := match assumedAt with
          | some (site, _, _) =>
            let origin := match p.siteOrigin[site]? with
              | some (pkg, i) => s!"{pkg}#{i}"
              | none => toString site
            { s' with stuck := s'.stuck <|> some s!"assumption at havoc site {origin}" }
          | none => s'
        if s'.log.size > before && (assumedAt.isSome || !decided) then (.specUnknown, s', some v)
        else if b then (.holds, s', some v) else (.violated, s', some v)
      | (.ok _, s) => (.specPanicked .modelStuck, s, some v)
      | (.panic k, s) => (.specPanicked k, s, some v)
      | (.outOfFuel, s) => (.outOfFuel, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) => (.outOfFuel, s, none)
  | .sequence f =>
    match GoConc.runAny p or h f args fuel heap snap with
    | (.ok (.bool true), s) => (.holds, s, some (.bool true))
    | (.ok (.bool false), s) =>
      -- A false verdict that read havoc stands only if every other havoc
      -- assignment gives it too.
      let decided := s.log.isEmpty || (!alts.isEmpty && alts.all fun h' =>
        match GoConc.runAny p or h' f args fuel heap snap with
        | (.ok (.bool false), _) => true
        | _ => false)
      if decided then (.violated, s, some (.bool false)) else (.specUnknown, s, some (.bool false))
    | (.ok v, s) => (.specPanicked .modelStuck, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) => (.outOfFuel, s, none)
  | .noHang f =>
    match GoConc.runAny p or h f args fuel heap with
    | (.ok v, s) => (.holds, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) =>
      -- The run ran out of fuel: a hang if it came back to a state.
      match lassoOf p or h prop args fuel heap with
      | some l => (.hangs l.site, { s with panicAt := some l.site }, none)
      | none => (.outOfFuel, s, none)

/-- Does the outcome refute the property? A stuck model never does. -/
def Outcome.refutes : Property → Outcome → Bool
  | .noPanic _, .panicked k => !k.isStuck
  | .postcondition .., .violated => true
  | .sequence _, .violated => true
  | .sequence _, .panicked k => !k.isStuck
  | .noHang _, .hangs _ => true
  | _, _ => false

/-- Other values a havoc read could have taken: an integer one up, one
down and zero (a read far past a threshold, such as a negative count, is
not moved back across it by one), a bool or an error the other way. Strings
and assumption markers are fixed guesses, not perturbed. -/
def havocAlternatives : Val → List Val
  | .int w x => [.int w (x + 1), .int w (x - 1)] ++ (if x == 0 then [] else [.int w 0])
  | .bool b => [.bool !b]
  | .err e => [.err !e]
  | _ => []

/-- The havoc reads a refutation depends on (#84): rerun the same input once
per read, that read changed and the others kept; a read whose change makes
the refutation go away is relevant. The schedule's draws are left alone
(schedule dependence is judged by the replay). Interpolation in CPAchecker's
value analysis, done by re-execution instead of a solver. -/
def relevantHavoc (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val) (s : HState Val) (snap : Option GoConc.Snap := none) : List (Nat × Nat) :=
  let reads := s.log.toList.filter fun (site, _, _) => some site != p.schedSite
  reads.filterMap fun (site, iter, v) =>
    let gone := (havocAlternatives v).any fun v' =>
      let h' : Havoc Val := fun st it => if st == site && it == iter then v' else h st it
      -- The same assignment as `alts`: the rerun's verdict is its own.
      let (o', _, _) := check p or h' prop args fuel heap [h'] snap
      !o'.refutes prop
    if gone then some (site, iter) else none

/-- How many of a refutation's havoc reads `relevantHavoc` could perturb. -/
def perturbable (p : GoSSA.Prog) (s : HState Val) : Nat :=
  (s.log.toList.filter fun (site, _, v) => some site != p.schedSite && !(havocAlternatives v).isEmpty).length

/-- A run that is neither a refutation nor support: the model got stuck, or
a postcondition's target panicked before the oracle ran. Counted so that a
clean pass is not mistaken for a certificate. -/
def Outcome.moot : Property → Outcome → Bool
  | .postcondition .., .panicked _ => true
  | .postcondition .., .specPanicked _ => true
  | .postcondition .., .specUnknown => true
  | .sequence _, .specUnknown => true
  | .sequence _, .specPanicked _ => true
  | _, .panicked k => k.isStuck
  | _, _ => false

-- Reporting ------------------------------------------------------------------

def renderInt (signed : Bool) (v : BitVec w) : String :=
  if signed then toString v.toInt else toString v.toNat

/-- Flatten one argument into the model parameter names M3 expects. -/
def flatten : Gen → Val → List (String × Json)
  | .int name _ signed, .int _ v => [(name, renderInt signed v)]
  | .bool name, .bool b => [(name, toString b)]
  | .err name, .err nonNil => [(name, if nonNil then "error" else "nil")]
  | .slice name _ _ _, .slice ref off len cap
  | .sliceOf name _ _, .slice ref off len cap =>
    [(name ++ "_ref", toString ref), (name ++ "_off", renderInt false off),
     (name ++ "_len", renderInt false len), (name ++ "_cap", renderInt false cap)]
  | .structv .., _ => []
  | .ptr .., _ => []
  | .link .., _ => []
  | .str .., _ => [] -- reported under objects, where the heap is available
  | .nilptr .., _ => []
  | .ref .., _ => []
  | .opaque .., _ => []
  | .arrOf .., _ => []
  | .mapOf .., _ => []
  | .anyOf .., _ => []
  | .jsonText .., _ => []
  | .sdkDoc .., _ => []
  | .hot .., _ => []
  | g, _ => [(genName g, "?")]
where
  genName : Gen → String
    | .int n .. => n | .bool n => n | .err n => n | .slice n .. => n | .structv n .. => n | .ptr n .. => n
    | .str n .. => n | .nilptr n => n | .ref n _ => n | .sliceOf n .. => n | .opaque n _ => n | .arrOf n .. => n | .link n _ => n
    | .mapOf n .. => n | .anyOf n _ => n | .jsonText n .. => n | .sdkDoc n .. => n | .hot inner => genName inner

/-- Bytes as a JSON string (UTF-8 decoded; invalid sequences become U+FFFD). -/
def bytesToJson (bs : List Nat) : Json :=
  Json.str (String.fromUTF8! (ByteArray.mk (bs.map fun b => UInt8.ofNat b).toArray))

/-- Render a value as the JSON M3 materialises: integers and bools as
strings, structs as arrays of fields, pointers as null or the pointee. -/
partial def renderObj (heap : Heap Val) (signed : Bool) : Val → Json
  | .int _ v => Json.str (renderInt signed v)
  | .bool b => Json.str (toString b)
  | .err nonNil => Json.str (if nonNil then "error" else "nil")
  | .structv fs => Json.arr (fs.map (renderObj heap signed)).toArray
  | .arr es => Json.arr (es.map (renderObj heap signed)).toArray
  | .ptr 0 _ => Json.null
  | .ptr ref path =>
    match heap[ref]? >>= (getPath · path) with
    -- A non-nil pointer to an opaque object: not null, so M3 builds a
    -- pointer to the pointee's zero value instead of passing nil.
    | some .unit | some .opaqueNil | some (.boxed ..) => Json.str "opaque"
    | some v => renderObj heap signed v
    | none => Json.str "?"
  | .slice 0 _ _ _ => Json.null
  | .unit => Json.null
  -- Opaque values: M3 passes the zero value (nil) for inputs of these types.
  | .opaqueNil => Json.null
  -- A map the generator or the program built: its entries in order.
  | m@(.boxed 1 _) =>
    match mapEntries heap m with
    | some (_, es) => Json.mkObj [("map", Json.arr (es.map fun (k, v) =>
        Json.arr #[renderObj heap signed k, renderObj heap signed v]).toArray)]
    | none => Json.null
  -- A value in an interface: its type tag and the value (funcs: nil).
  | .boxed 0 _ => Json.null
  | .boxed t v => Json.mkObj [("tag", (t : Json)), ("v", renderObj heap signed v)]
  | s@(.str ..) =>
    match strBytes heap s with
    | some bs => bytesToJson bs
    | none => Json.str "?"
  | .slice ref off len _ =>
    match heap[ref]? with
    | some (.arr es) => Json.arr ((es.drop off.toNat).take len.toNat |>.map (renderObj heap signed)).toArray
    | _ => Json.str "?"
  | v => Json.str (toString (repr v))

/-- The slice contents of each slice argument (from the heap when
materialised, else from the oracle), keyed by parameter name. -/
def memoryOf (or : Oracle) (heap : Heap Val) (gens : List Gen) (args : List Val) : List (String × Json) :=
  (gens.zip args).filterMap fun
    | (.slice name w signed _, .slice ref off len cap) =>
      match heap[ref]? with
      | some (.arr _) => some (name, renderObj heap signed (.slice ref off len cap))
      | _ =>
        let elems := (List.range len.toNat).map fun j =>
          Json.str (renderInt signed ((or.mem ref (off + BitVec.ofNat 64 j)).zeroExtend w))
        some (name, Json.arr elems.toArray)
    | _ => none

/-- Struct and pointer arguments as nested JSON, keyed by parameter name. -/
def objectsOf (heap : Heap Val) (gens : List Gen) (args : List Val) : List (String × Json) :=
  (gens.zip args).filterMap fun
    | (.structv name _, v) => some (name, renderObj heap true v)
    | (.ptr name _, v) => some (name, renderObj heap true v)
    | (.link name _, v) => some (name, renderObj heap true v)
    | (.str name .., v) => some (name, renderObj heap true v)
    | (.nilptr name, v) => some (name, renderObj heap true v)
    | (.ref name _, v) => some (name, renderObj heap true v)
    | (.sliceOf name _ _, v) => some (name, renderObj heap true v)
    | (.opaque name _, _) => some (name, Json.null)
    | (.arrOf name _ _, v) => some (name, renderObj heap true v)
    | (.mapOf name .., v) => some (name, renderObj heap true v)
    | (.anyOf name _, v) => some (name, renderObj heap true v)
    | (.jsonText name .., v) => some (name, renderObj heap true v)
    | (.sdkDoc name .., v) => some (name, renderObj heap true v)
    | _ => none

partial def renderVal : Val → Json
  | .int _ v => Json.str (renderInt true v)
  | .bool b => Json.str (toString b)
  | .slice ref off len cap =>
    Json.str s!"slice(ref={ref}, off={off.toNat}, len={len.toNat}, cap={cap.toNat})"
  | .tuple vs => Json.arr (vs.map renderVal).toArray
  | .err nonNil => Json.str (if nonNil then "error" else "nil")
  | .ptr 0 _ => Json.str "nil"
  | .ptr ref path => Json.str s!"ptr(ref={ref}, path={path})"
  | .str ref off len => Json.str s!"str(ref={ref}, off={off.toNat}, len={len.toNat})"
  | .structv fs => Json.arr (fs.map renderVal).toArray
  | .arr es => Json.arr (es.map renderVal).toArray
  | .boxed t v => Json.mkObj [("type", (t : Json)), ("value", renderVal v)]
  | .opaqueNil => Json.str "nil"
  | .unit => Json.str "unit"

def modelOutput : Outcome → Option Val → Json
  | .panicked k, _ => Json.mkObj [("res", "panic"), ("panic", k.tag)]
  | .specPanicked k, v =>
    Json.mkObj [("res", "spec_panic"), ("panic", k.tag), ("value", (v.map renderVal).getD Json.null)]
  | .outOfFuel, _ => Json.mkObj [("res", "out_of_fuel")]
  | .hangs site, _ => Json.mkObj [("res", "hang"), ("at", site)]
  | _, v => Json.mkObj [("res", "ok"), ("value", (v.map renderVal).getD Json.null)]

def report (or : Oracle) (heap : Heap Val) (gens : List Gen) (args : List Val) (trial seed : Nat)
    (o : Outcome) (s : HState Val) (ret : Option Val) (origins : Array (String × Nat) := #[])
    (relevant : List (Nat × Nat) := []) (perturbed : Nat := 0) : Json :=
  let inputs := (gens.zip args).flatMap (fun (g, v) => flatten g v)
  let memory := memoryOf or heap gens args
  let objects := objectsOf heap gens args
  -- `origin`: the package and its own index of a linked site, so that the
  -- site can be found in that package's model report.
  let havoc := s.log.toList.map fun (site, iter, v) =>
    Json.mkObj ([("idx", (site : Json)), ("iter", iter), ("value", renderVal v)] ++
      match origins[site]? with
      | some (pkg, i) => [("origin", Json.str s!"{pkg}#{i}")]
      | none => [])
  let probes := s.probes.toList.map fun (label, v) =>
    Json.mkObj [("label", label), ("value", renderObj s.heap true v)]
  Json.mkObj [("found", true), ("trial", trial), ("seed", seed),
    ("inputs", Json.mkObj inputs), ("memory", Json.mkObj memory), ("objects", Json.mkObj objects),
    ("havoc", Json.arr havoc.toArray),
    ("relevant_havoc", Json.arr (relevant.map fun (site, iter) => Json.mkObj [("idx", (site : Json)), ("iter", iter)]).toArray),
    ("havoc_perturbed", perturbed),
    ("probes", Json.arr probes.toArray),
    ("assumptions", Json.arr (s.assumed.map Json.str)),
    ("model_output", modelOutput o ret), ("panic_at", (s.panicAt.map Json.str).getD Json.null),
    ("schedule", Json.arr (s.conc.sched.map fun (g, op, ps, pkg) =>
      Json.mkObj [("g", (g : Json)), ("op", Json.str op), ("partners", Json.arr (ps.toArray.map (fun (j : Nat) => (j : Json)))),
        ("pkg", Json.str pkg)]))]

/-- The block a postcondition's spec returned from, when the spec ran to
its end (the trial reached the oracle and the oracle finished). -/
def specExit (prop : Property) (o : Outcome) (s : HState Val) : Option String :=
  match prop, o with
  | .postcondition .., .holds | .postcondition .., .violated
  | .sequence _, .holds | .sequence _, .violated =>
    s.exit.map fun (_, b) => toString b
  | _, _ => none

/-- How long one run may take (ms) for its counterexample to get
`relevantHavoc`, which reruns it once or twice per havoc read: an
evaluation 7 harness (k016) takes about 100 s a run and reads dozens. -/
def relevanceMs : Nat := 5000

/-- `check`, timed: whether it took longer than `relevanceMs`. -/
def timedCheck (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val) (alts : List (Havoc Val)) (snap : Option GoConc.Snap) :
    IO (Outcome × HState Val × Option Val × Bool) := do
  let t0 ← IO.monoMsNow
  let (o, s, ret) ← IO.lazyPure fun _ => check p or h prop args fuel heap alts snap
  return (o, s, ret, (← IO.monoMsNow) - t0 > relevanceMs)

/-- A havoc-dependent counterexample's report, with the reads it depends
on unless its run was too slow to rerun per read (`relevance_skipped`). -/
def havocReport (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val) (snap : Option GoConc.Snap) (slow : Bool)
    (gens : List Gen) (trial seed : Nat) (o : Outcome) (s : HState Val) (ret : Option Val) : Json :=
  if slow then (report or heap gens args trial seed o s ret p.siteOrigin).setObjVal! "relevance_skipped" true
  else report or heap gens args trial seed o s ret p.siteOrigin
    (relevantHavoc p or h prop args fuel heap s snap) (perturbable p s)

/-- The heap the package initializers' slices leave (#55), run once, in
order, for all trials: every trial starts from it. With the report's
`init` field: how many ran and how many havoc reads they made (the same
in every trial), or why the trials start from an empty heap instead (its
cells at their zero values); and the under-approximation either is, for
the exhaustive engine's certificate. Nothing when the program has none. -/
def initHeap (p : GoSSA.Prog) (extra : List Nat) (fuel : Nat) :
    Heap Val × List (String × Json) × Option String :=
  if p.inits.isEmpty then (#[], [], none) else
  let or := oracleOf .mixed extra 0
  let h := havocOf 0 p.havocWidths
  let step : Except String (Heap Val × Nat) → Nat → Except String (Heap Val × Nat) := fun acc f =>
    match acc with
    | .error e => .error e
    | .ok (heap, reads) =>
      match GoConc.runAny p or h f [] fuel heap with
      | (.ok _, s) => .ok (s.heap, reads + s.log.size)
      | (.panic k, s) => .error s!"panic {repr k}{(s.stuck.map (" at " ++ ·)).getD ""}"
      | (.outOfFuel, _) => .error "out of fuel"
  match p.inits.foldl step (.ok (#[], 0)) with
  | .ok (heap, reads) =>
    (heap, [("init", Json.mkObj [("ran", p.inits.size), ("havoc_reads", reads)])],
     if reads == 0 then none
     else some "the package initializers' havoc reads are the same in every input (they run once, #55)")
  | .error e =>
    (#[], [("init", Json.mkObj [("ran", 0), ("error", e)])],
     some s!"the package initializers did not run ({e}): the variables they build start at zero values (#55)")

/-- A concurrent sequence harness's setup, run once for all trials (#87):
the snapshot at its `setupEnd`, when the setup depends on nothing a trial
draws. It starts from `heap`, the initializers' (`initHeap`). -/
def setupSnap (p : GoSSA.Prog) (prop : Property) (extra : List Nat) (fuel : Nat) (heap : Heap Val := #[]) :
    Option GoConc.Snap × Json :=
  match prop with
  | .sequence f =>
    if !GoConc.hasSetupEnd p f then (none, false) else
    match GoConc.captureSetup p (oracleOf .mixed extra 0) (havocOf 0 p.havocWidths) f fuel heap with
    | .ok snap => (some snap, true)
    | .error why => (none, why)
  | _ => (none, false)

/-- Run `trials` random trials; print one JSON line, `{"found": false, ...}` if nothing refutes. -/
def run (p : GoSSA.Prog) (prop : Property) (gens : List Gen) (extra : List Nat)
    (seed trials fuel : Nat) (strs : List String := []) (table : TypeTable := #[])
    (allowNil : Bool := true) (budgetMs : Nat := 0) : IO Unit := do
  let pool := strs.map fun s => s.toUTF8.toList.map (·.toNat)
  let mut g := mkStdGen seed
  let mut fuelOuts := 0
  let mut moots := 0
  let mut stuckSites : List (String × Nat) := []
  let mut fallback : Option Json := none
  let mut exits : List (String × Nat) := []
  let mut lassoChecked := 0
  let mut loops := 0
  let mut loopSites : List (String × Nat) := []
  let mut stepFuel : List (String × Nat) := []
  let trace := (← IO.getEnv "GO2LEAN_TRACE").isSome
  let start ← IO.monoMsNow
  let (heap0, initNote, initAssumed) := initHeap p extra fuel
  let (snap, snapNote) := setupSnap p prop extra fuel heap0
  let base := (snap.map (·.s.heap)).getD heap0
  let mut done := 0
  for trial in [0:trials] do
    -- A wall-clock budget (0: none) bounds a property whose inputs are
    -- expensive to draw; the report says how many trials ran.
    if budgetMs > 0 && (← IO.monoMsNow) - start > budgetMs then break
    done := trial + 1
    let (pfn, g') := randNat g 0 2
    g := g'
    let pf := Profile.ofNat pfn
    -- Memory and havoc are re-drawn every trial; the trial seed makes them reproducible.
    let tseed := (mixHash (UInt64.ofNat seed) (UInt64.ofNat trial)).toNat
    let or := oracleOf pf extra tseed
    let h := havocOf tseed p.havocWidths
    let (args, g', heap) := genArgs pf extra g gens pool table allowNil base
    g := g'
    if trace then
      -- GO2LEAN_TRACE: every input before it runs, for crashes that leave
      -- no report behind.
      IO.eprintln (Json.mkObj [("trial", trial), ("objects", Json.mkObj (objectsOf heap gens args)),
        ("inputs", Json.mkObj ((gens.zip args).flatMap fun (g, v) => flatten g v))]).compress
    let alts := [havocOf (tseed + 7919) p.havocWidths, havocOf (tseed + 104729) p.havocWidths]
    let (o, s, ret, slow) ← timedCheck p or h prop args fuel heap alts snap
    if trace then IO.eprintln s!"done trial {trial}: {repr o}"
    if o.refutes prop then
      -- Report the initial heap: what the inputs looked like before the run.
      -- A refutation whose run read a havoc value (an unmodelled call) is
      -- kept as a fallback while the search goes on for one that did not:
      -- M3 refutes most havoc-dependent ones.
      if s.log.size == 0 then
        IO.println (report or heap gens args trial seed o s ret p.siteOrigin).compress
        return
      else if fallback.isNone then
        fallback := some (havocReport p or h prop args fuel heap snap slow gens trial seed o s ret)
    if let .outOfFuel := o then
      fuelOuts := fuelOuts + 1
      if let some site := s.stuck then
        if site.startsWith "out of fuel in a goroutine" then stepFuel := bump stepFuel site
      if lassoChecked < lassoLimit && !prop.isNoHang then
        lassoChecked := lassoChecked + 1
        if let some l := lassoOf p or h prop args fuel heap snap then
          loops := loops + 1
          loopSites := bump loopSites (if l.assumed then l.site ++ " (under assumptions)" else l.site)
    if let some b := specExit prop o s then exits := bump exits b
    if o.moot prop then
      moots := moots + 1
      if let some site := s.stuck then
        -- Where: the function and block the run stopped in, when known.
        let place := match s.panicAt with
          | some w => if w.startsWith "@" then (w.takeWhile (· != ':')).toString ++ ": " else ""
          | none => ""
        stuckSites := bump stuckSites (place ++ site)
  if let some j := fallback then
    IO.println (j.setObjVal! "havoc_dependent" true).compress
    return
  let top := (stuckSites.toArray.qsort (fun a b => a.2 > b.2)).toList.take 5
  IO.println (Json.mkObj (([("found", false), ("trials", done), ("out_of_fuel", fuelOuts),
    ("moot", moots), ("budget_hit", decide (done < trials)), ("setup_snapshot", snapNote)] : List (String × Json)) ++ initNote ++ ([
    ("stuck_sites", Json.mkObj (top.map fun (site, n) => (site, (n : Json)))),
    ("spec_exits", Json.mkObj (exits.map fun (b, n) => (b, (n : Json))))] : List (String × Json)) ++
    loopFields lassoChecked loops loopSites ++ stepFuelFields stepFuel)).compress
where
  bump (sites : List (String × Nat)) (site : String) : List (String × Nat) :=
    match sites.lookup site with
    | some n => (site, n + 1) :: sites.filter (·.1 != site)
    | none => (site, 1) :: sites

-- Mutation engine -----------------------------------------------------------

/-- The operator a test would swap in for `o`: the negated comparison, the
other additive operator. -/
def mutOp : GoSSA.Op → Option GoSSA.Op
  | .eq => some .ne | .ne => some .eq
  | .slt => some .sge | .sge => some .slt | .sle => some .sgt | .sgt => some .sle
  | .ult => some .uge | .uge => some .ult | .ule => some .ugt | .ugt => some .ule
  | .add => some .sub | .sub => some .add
  | _ => none

/-- One mutant of the code under test: a branch with its targets swapped
(the condition negated), or one operator replaced (`mutOp`). -/
structure Mutant where
  fid : Nat
  blk : Nat
  instr : Option (Nat × GoSSA.Op)
  desc : String

/-- Every mutant of the functions `fids`, in program order. -/
def mutants (p : GoSSA.Prog) (fids : List Nat) : List Mutant :=
  fids.flatMap fun fid =>
    match p.funcs[fid]? with
    | none => []
    | some fn =>
      (List.range fn.blocks.size).flatMap fun bi =>
        match (fn.blocks[bi]? : Option (SSA.Block GoSSA.Op)) with
        | none => []
        | some blk =>
          let brs : List Mutant := match blk.term with
            | .br .. => [{ fid, blk := bi, instr := none, desc := s!"{fn.name} block {bi}: branch negated" }]
            | _ => []
          let ops : List Mutant := (List.range blk.instrs.size).filterMap fun ii =>
            match (blk.instrs[ii]? : Option GoSSA.Instr) with
            | some (SSA.Instr.op _ o _) => (mutOp o).map fun o' =>
                { fid, blk := bi, instr := some (ii, o'),
                  desc := s!"{fn.name} block {bi}: {opName o} → {opName o'}" }
            | _ => none
          brs ++ ops
where
  opName (o : GoSSA.Op) : String := ((toString (repr o)).replace "Go2Lean.GoSSA.Op." "")

def Mutant.apply (m : Mutant) (p : GoSSA.Prog) : GoSSA.Prog :=
  { p with funcs := p.funcs.modify m.fid fun fn =>
    { fn with blocks := fn.blocks.modify m.blk fun blk =>
      match m.instr with
      | none => match blk.term with
        | .br c t ta f fa => { blk with term := .br c f fa t ta }
        | _ => blk
      | some (ii, o') => { blk with instrs := blk.instrs.modify ii fun
          | SSA.Instr.op d _ a => SSA.Instr.op d o' a
          | i => i } } }

/-- At most `n` of `xs`, spread evenly over it. -/
def spread (xs : List α) (n : Nat) : List α :=
  if xs.length ≤ n || n == 0 then xs
  else (List.range n).filterMap fun i => xs[i * xs.length / n]?

/-- Does the property tell the code under test from its mutants? For each
mutant (at most `maxMutants`), a random search like `run`'s looks for a
distinguishing input: one on which the mutant violates the property and
the original program does not. A property no mutant violates checks
nothing a one-line change could break (it may be vacuous, or too weak). -/
def mutate (p : GoSSA.Prog) (prop : Property) (fids : List Nat) (gens : List Gen) (extra : List Nat)
    (seed trials fuel : Nat) (strs : List String := []) (table : TypeTable := #[])
    (allowNil : Bool := true) (budgetMs : Nat := 0) (maxMutants : Nat := 24) : IO Unit := do
  let pool := strs.map fun s => s.toUTF8.toList.map (·.toNat)
  let all := mutants p fids
  let chosen := spread all maxMutants
  let per := if chosen.isEmpty then 0 else budgetMs / chosen.length
  let (base, _, _) := initHeap p extra fuel
  let mut killed : List Json := []
  let mut survived : List String := []
  for m in chosen do
    let pm := m.apply p
    let mstart ← IO.monoMsNow
    let mut g := mkStdGen seed
    let mut hit : Option Nat := none
    for trial in [0:trials] do
      if per > 0 && (← IO.monoMsNow) - mstart > per then break
      let (pfn, g') := randNat g 0 2
      g := g'
      let pf := Profile.ofNat pfn
      let tseed := (mixHash (UInt64.ofNat seed) (UInt64.ofNat trial)).toNat
      let or := oracleOf pf extra tseed
      let h := havocOf tseed p.havocWidths
      let (args, g', heap) := genArgs pf extra g gens pool table allowNil base
      g := g'
      let (o, _, _) := check pm or h prop args fuel heap
      if o.refutes prop then
        -- The original need not pass on that input: a target that panics
        -- there (moot for a postcondition) still told the mutant apart.
        let (o0, _, _) := check p or h prop args fuel heap
        if !(o0.refutes prop) then
          hit := some trial
          break
    match hit with
    | some t => killed := Json.mkObj [("mutant", m.desc), ("trial", t)] :: killed
    | none => survived := m.desc :: survived
  IO.println (Json.mkObj [("mutation", true), ("mutants_total", all.length), ("tried", chosen.length),
    ("killed", killed.length), ("killed_by", Json.arr killed.reverse.toArray),
    ("survived", Json.arr (survived.reverse.map Json.str).toArray)]).compress

-- Exhaustive engine ---------------------------------------------------------

/-- In `extra`, asks the exhaustive engine for the narrow integer domain:
the program's own constants with 0 and 1 (a sequence spec's alphabet, so
that every short sequence can be enumerated). Above 2^64, so no constant
(a two's-complement bit pattern) is mistaken for it. -/
def narrowMark : Nat := 2 ^ 64 + 1

/-- The value set the exhaustive engine enumerates for `w`-bit integers:
boundary values, mined literals and their neighbours, and magnitudes up to 8
(or the narrow domain, see `narrowMark`). -/
def smallInts (w : Nat) (extra : List Nat) : List (BitVec w) :=
  if extra.contains narrowMark then
    ([0#w, 1#w] ++ (mined w (extra.filter (· != narrowMark))).toList).eraseDups
  else
  ((specials w ++ mined w extra).toList ++
    (List.range 17).map fun n => BitVec.ofInt w (Int.ofNat n - 8)).eraseDups

/-- All length-`n` tuples over `xs`. -/
def tuples (xs : List α) : Nat → List (List α)
  | 0 => [[]]
  | n + 1 => (tuples xs n).flatMap fun t => xs.map (· :: t)

/-- The strings the exhaustive engine tries: the empty string, a space, one
letter, one digit, the boundary numbers, and every pool literal with its
neighbours and number suffixes. -/
def smallStrs (extra : List Nat) (pool : List (List Nat)) : List (List Nat) :=
  let numbers := numberStrs extra
  dedup ([[], [32], [97], [48]] ++ numbers ++
    pool.flatMap fun (b : List Nat) => [b, b.dropLast, b ++ [120]] ++ numbers.map (b ++ ·))
where
  /-- `eraseDups` in linear time: a literal pool of thousands of strings
  (`-deps`) made the quadratic one stall the exhaustive engine before its
  budget check. -/
  dedup (xs : List (List Nat)) : List (List Nat) :=
    let (_, out) := xs.foldl (init := ((∅ : Std.HashSet (List Nat)), (#[] : Array (List Nat))))
      fun (seen, out) x => if seen.contains x then (seen, out) else (seen.insert x, out.push x)
    out.toList

/-- How many values of each dynamic type the exhaustive engine puts in an
empty interface. -/
def anyPerType : Nat := 8

/-- Enumerate one parameter as a heap-building function: each candidate
takes the heap so far and returns the value and the extended heap. -/
partial def enumGen (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable := #[])
    (depth : Nat := 2) (allowNil : Bool := true) : Gen → List (Heap Val → Val × Heap Val)
  | .int _ w _ => (smallInts w extra).map fun v heap => (.int w v, heap)
  | .bool _ => [fun heap => (.bool true, heap), fun heap => (.bool false, heap)]
  | .err _ => [fun heap => (.err false, heap), fun heap => (.err true, heap)]
  | .slice _ w _ maxLen' =>
    let elems := (smallInts w extra).map fun v => Val.int w v
    (List.range (min maxLen maxLen' + 1)).flatMap fun len =>
      (tuples elems len).map fun t heap =>
        let (p, heap) := heapAlloc heap (.arr t)
        match p with
        | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 len), heap)
        | _ => (.unit, heap)
  | .sliceOf _ elem maxLen' =>
    (List.range (if depth == 0 then 1 else min maxLen maxLen' + 1)).flatMap fun len =>
      (enumList extra maxLen pool table (depth - 1) allowNil (List.replicate len elem)).map fun build heap =>
        let (vs, heap) := build heap
        let (p, heap) := heapAlloc heap (.arr vs)
        match p with
        | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 len), heap)
        | _ => (.unit, heap)
  | .structv _ fields =>
    (enumVariants fields).flatMap fun fields =>
      (enumList extra maxLen pool table depth allowNil fields).map fun build heap =>
        let (vs, heap) := build heap
        (.structv vs, heap)
  | .hot inner => enumGen extra maxLen pool table depth allowNil inner
  | .sdkDoc _ t d inner =>
    (enumGen extra maxLen pool table depth allowNil inner).map fun build heap =>
      let (v, heap) := build heap
      (sdkNormalize t d heap v).getD (v, heap)
  | .ptr _ pointee =>
    (if depth > 0 && !allowNil then [] else [fun heap => (.ptr 0 [], heap)]) ++
      (if depth == 0 then [] else
        (enumGen extra maxLen pool table (depth - 1) allowNil pointee).map fun build heap =>
          let (obj, heap) := build heap
          heapAlloc heap obj)
  | .link _ pointee =>
    [fun heap => (.ptr 0 [], heap)] ++
      (if depth == 0 then [] else
        (enumGen extra maxLen pool table (depth - 1) allowNil pointee).map fun build heap =>
          let (obj, heap) := build heap
          heapAlloc heap obj)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields =>
      (enumVariants fields).flatMap fun fields =>
        (enumList extra maxLen pool table depth allowNil fields).map fun build heap =>
          let (vs, heap) := build heap
          (.structv vs, heap)
    | none => [fun heap => (.unit, heap)]
  | .str _ maxLen' enum =>
    -- A named string type: its constants, the empty string and one other.
    let strs := if maxLen' == 0 then [[]]
      else if !enum.isEmpty then (enum ++ [[], [97]]).eraseDups
      else smallStrs extra pool
    strs.map fun bs heap => strAlloc heap bs
  | .nilptr _ => [fun heap => (.ptr 0 [], heap)]
  | .opaque _ v => [fun heap => (v, heap)]
  | .arrOf _ elem n =>
    (enumList extra maxLen pool table (depth - 1) allowNil (List.replicate n elem)).map fun build heap =>
      let (vs, heap) := build heap
      (.arr vs, heap)
  | .mapOf name key val _ =>
    -- nil (when allowed, and below the top for an exported field, as in
    -- genVal), empty, and every map of one entry.
    (if allowNil || (depth < enumTop && !name.front.isLower) then [fun heap => (.opaqueNil, heap)] else []) ++
    [fun heap => let (p, heap) := heapAlloc heap (mapObj []); (.boxed 1 p, heap)] ++
    (if depth == 0 then [] else
      (enumList extra maxLen pool table (depth - 1) allowNil [key, val]).map fun build heap =>
        let (kv, heap) := build heap
        match kv with
        | [k, v] => let (p, heap) := heapAlloc heap (mapObj [(k, v)]); (.boxed 1 p, heap)
        | _ => (.unit, heap))
  | .jsonText _ keys vals =>
    -- Empty, and one member for each of the first keys with each value.
    let objs := (keys.take 8).flatMap fun k => (jsonValues (vals.take 3)).map fun v => jsonObject [(k, v)]
    ([] :: objs).map fun bs heap => strAlloc heap bs
  | .anyOf _ alts =>
    -- The interface itself costs no depth: its map or slice does, and at
    -- depth zero only scalars are left.
    let alts := if depth == 0 then alts.filter (fun (_, a) => match a with | .mapOf .. | .sliceOf .. => false | _ => true) else alts
    -- nil and the first `anyPerType` values of each dynamic type: an
    -- interface stays a few dozen values, not the product of every type.
    [fun heap => (.opaqueNil, heap)] ++
      alts.flatMap fun (tag, a) =>
        ((enumGen extra maxLen pool table depth allowNil a).take anyPerType).map fun build heap =>
          let (v, heap) := build heap
          (.boxed tag v, heap)
where
  /-- The field lists to enumerate: one per variant for a union, else the
  fields as they are. -/
  enumVariants (fields : List Gen) : List (List Gen) :=
    let n := variantCount fields
    if n ≥ 2 then (List.range n).map (selectVariant table fields) else [fields]
  enumList (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable) (depth : Nat)
      (allowNil : Bool) : List Gen → List (Heap Val → List Val × Heap Val)
    | [] => [fun heap => ([], heap)]
    | g :: gs =>
      (enumGen extra maxLen pool table depth allowNil g).flatMap fun build =>
        (enumList extra maxLen pool table depth allowNil gs).map fun rest heap =>
          let (v, heap) := build heap
          let (vs, heap) := rest heap
          (v :: vs, heap)

/-- The number of leaf generators in a description, table references
expanded once: the exhaustive engine only enumerates small signatures,
since the builders of a wide structure are expensive to construct even
when the domain is small. -/
partial def leaves (table : TypeTable) (seen : List Nat := []) : Gen → Nat
  | .structv _ fields => structLeaves table seen fields
  | .ptr _ pointee | .link _ pointee | .sliceOf _ pointee _ | .arrOf _ pointee _ => 1 + leaves table seen pointee
  | .sdkDoc _ _ _ inner | .hot inner => leaves table seen inner
  | .mapOf _ key val _ => 1 + leaves table seen key + leaves table seen val
  | .anyOf _ alts => 1 + (alts.map fun (_, a) => leaves table seen a).foldl max 0
  | .ref _ tyIdx =>
    if seen.contains tyIdx then 1
    else match table[tyIdx]? with
      | some fields => structLeaves table (tyIdx :: seen) fields
      | none => 1
  | _ => 1
where
  /-- A union counts its widest variant, since one is live at a time. -/
  structLeaves (table : TypeTable) (seen : List Nat) (fields : List Gen) : Nat :=
    let (vars, rest) := fields.partition Gen.isVariant
    (rest.map (leaves table seen)).sum +
      (if vars.length ≥ 2 then (vars.map (leaves table seen)).foldl max 0 else (vars.map (leaves table seen)).sum)

/-- Size of the domain `enumArgs` would produce, computed before building it. -/
partial def genSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable := #[])
    (depth : Nat := 2) (allowNil : Bool := true) : Gen → Nat
  | .int _ w _ => (smallInts w extra).length
  | .bool _ => 2
  | .err _ => 2
  | .slice _ w _ maxLen' =>
    let k := (smallInts w extra).length
    (List.range (min maxLen maxLen' + 1)).foldl (fun acc len => acc + k ^ len) 0
  | .sliceOf _ elem maxLen' =>
    -- At depth 0 only the empty slice is built; the element is not sized,
    -- since a recursive element type would never bottom out.
    if depth == 0 then 1 else
    let k := genSize extra maxLen pool table (depth - 1) allowNil elem
    (List.range (min maxLen maxLen' + 1)).foldl (fun acc len => acc + k ^ len) 0
  | .structv _ fields => structSize extra maxLen pool table depth allowNil fields
  | .sdkDoc _ _ _ inner | .hot inner => genSize extra maxLen pool table depth allowNil inner
  | .ptr _ pointee => (if depth > 0 && !allowNil then 0 else 1) + (if depth == 0 then 0 else genSize extra maxLen pool table (depth - 1) allowNil pointee)
  | .link _ pointee => 1 + (if depth == 0 then 0 else genSize extra maxLen pool table (depth - 1) allowNil pointee)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields => structSize extra maxLen pool table depth allowNil fields
    | none => 1
  | .str _ maxLen' enum =>
    if maxLen' == 0 then 1 else if !enum.isEmpty then (enum ++ [[], [97]]).eraseDups.length
    else (smallStrs extra pool).length
  | .opaque .. => 1
  | .arrOf _ elem n => (genSize extra maxLen pool table (depth - 1) allowNil elem) ^ n
  | .nilptr _ => 1
  | .jsonText _ keys vals => 1 + (keys.take 8).length * (jsonValues (vals.take 3)).length
  | .mapOf _ key val _ =>
    (if allowNil then 1 else 0) + 1 + (if depth == 0 then 0 else
      genSize extra maxLen pool table (depth - 1) allowNil key * genSize extra maxLen pool table (depth - 1) allowNil val)
  | .anyOf _ alts =>
    let alts := if depth == 0 then alts.filter (fun (_, a) => match a with | .mapOf .. | .sliceOf .. => false | _ => true) else alts
    1 + (alts.map fun (_, a) => min anyPerType (genSize extra maxLen pool table depth allowNil a)).sum
where
  structSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable) (depth : Nat)
      (allowNil : Bool) (fields : List Gen) : Nat :=
    let product (fs : List Gen) := fs.foldl (fun acc f => acc * genSize extra maxLen pool table depth allowNil f) 1
    let n := variantCount fields
    if n ≥ 2 then ((List.range n).map fun k => product (selectVariant table fields k)).sum else product fields

def domainSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (gens : List Gen)
    (table : TypeTable := #[]) (allowNil : Bool := true) : Nat :=
  gens.foldl (fun acc g => acc * genSize extra maxLen pool table 2 allowNil g) 1

/-- The inputs of the small domain as heap builders, so that the heaps are
built one at a time inside the engine's budget. -/
def enumArgs (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (gens : List Gen)
    (table : TypeTable := #[]) (allowNil : Bool := true) : List (Heap Val → List Val × Heap Val) :=
  enumGen.enumList extra maxLen pool table enumTop allowNil gens

/-- `h` with the schedule site's draws forced: the first ones to `pre`, the
rest to 0 (the first ready goroutine, the first ready case). -/
def forceSched (h : Havoc Val) (site : Nat) (pre : Array Nat) : Havoc Val := fun st it =>
  if st == site then .int 64 (BitVec.ofNat 64 (pre[it]?.getD 0)) else h st it

/-- The schedule after one whose draws took `choices`, each below its
`arity`: the last draw with an untried option, advanced, and nothing after
it; none when every schedule has run (depth first). -/
def nextSched (choices arity : Array Nat) : Option (Array Nat) := Id.run do
  let mut j := min choices.size arity.size
  while j > 0 do
    j := j - 1
    if choices[j]! + 1 < arity[j]! then
      return some ((choices.extract 0 j).push (choices[j]! + 1))
  return none

/-- The most schedules the exhaustive engine runs for one input, and for
one property over all its inputs; past them an input's schedules count as
sampled (no certificate for every interleaving). -/
def schedLimit : Nat := 2000
def schedTotal : Nat := 10000

/-- Try every input in the small domain. Prints a counterexample line, or
`{"found": false, "exhaustive": true, ...}` when the whole domain holds, or
`"exhaustive": false` when the domain exceeds `limit`. Havoc sites (if any)
are not enumerated; they take seed-derived values (three per input), and
`havoc_read` counts the inputs whose run read one; `assumptions` lists the
under-approximations the runs took. The schedule of a concurrent run is
enumerated (C3): every interleaving, up to `schedLimit` per input and
`schedTotal` in all; an input whose schedules all ran, none out of fuel,
reads no havoc through them. -/
def exhaust (p : GoSSA.Prog) (prop : Property) (gens : List Gen) (extra : List Nat)
    (maxLen limit fuel : Nat) (strs : List String := []) (table : TypeTable := #[])
    (allowNil : Bool := true) (budgetMs : Nat := 0) : IO Unit := do
  let pool := strs.map fun s => s.toUTF8.toList.map (·.toNat)
  let width := (gens.map (leaves table)).sum
  if width > 24 then
    IO.println (Json.mkObj [("found", false), ("exhaustive", false),
      ("reason", "signature too wide"), ("domain", width), ("limit", 24)]).compress
    return
  let n := domainSize extra maxLen pool gens table allowNil
  if n > limit then
    IO.println (Json.mkObj [("found", false), ("exhaustive", false),
      ("reason", "domain too large"), ("domain", (min n (10 ^ 300) : Nat)), ("limit", limit)]).compress
    return
  let h := havocOf 0 p.havocWidths
  let or := oracleOf .mixed extra 0
  let (heap0, initNote, initAssumed) := initHeap p extra fuel
  let (snap, snapNote) := setupSnap p prop extra fuel heap0
  let base := (snap.map (·.s.heap)).getD heap0
  let mut fuelOuts := 0
  let mut moots := 0
  let mut havocRuns := 0
  let mut schedRuns := 0
  let mut schedSampled := 0
  -- The under-approximations any input's run took: a domain that held
  -- through one of them is no certificate for what it left out.
  let mut assumed : Array String := initAssumed.toArray
  let mut i : Nat := 0
  let mut fallback : Option Json := none
  let mut exits : List (String × Nat) := []
  let mut lassoChecked := 0
  let mut loops := 0
  let mut loopSites : List (String × Nat) := []
  let mut stepFuel : List (String × Nat) := []
  let start ← IO.monoMsNow
  for build in enumArgs extra maxLen pool gens table allowNil do
    let (args, heap) := build base
    if budgetMs > 0 && (← IO.monoMsNow) - start > budgetMs then
      -- Out of time: no certificate, but say how far it got.
      IO.println (Json.mkObj [("found", false), ("exhaustive", false), ("reason", "budget"),
        ("domain", n), ("limit", limit), ("checked", (i : Nat))]).compress
      return
    let alts := [havocOf 1 p.havocWidths, havocOf 2 p.havocWidths]
    let (o, s, ret, slow) ← timedCheck p or h prop args fuel heap alts snap
    if o.refutes prop then
      if s.log.size == 0 then
        IO.println (report or heap gens args i 0 o s ret p.siteOrigin).compress
        return
      else if fallback.isNone then
        fallback := some (havocReport p or h prop args fuel heap snap slow gens i 0 o s ret)
    if let .outOfFuel := o then
      fuelOuts := fuelOuts + 1
      if let some site := s.stuck then
        if site.startsWith "out of fuel in a goroutine" then stepFuel := run.bump stepFuel site
      if lassoChecked < lassoLimit && !prop.isNoHang then
        lassoChecked := lassoChecked + 1
        if let some l := lassoOf p or h prop args fuel heap snap then
          loops := loops + 1
          loopSites := run.bump loopSites (if l.assumed then l.site ++ " (under assumptions)" else l.site)
    if let some b := specExit prop o s then exits := run.bump exits b
    if o.moot prop then moots := moots + 1
    for a in s.assumed do
      if !assumed.contains a && assumed.size < 32 then assumed := assumed.push a
    match p.schedSite with
    | some site =>
      if s.conc.arity.isEmpty || o.refutes prop then
        if s.log.size > 0 then havocRuns := havocRuns + 1
      else
        -- Every schedule of this input, depth first.
        let mut pre : Option (Array Nat) := some #[]
        let mut runs := 0
        let mut complete := true
        let mut other := false
        while true do
          let some pf := pre | break
          if runs ≥ schedLimit || schedRuns + runs ≥ schedTotal ||
              (budgetMs > 0 && (← IO.monoMsNow) - start > budgetMs) then
            complete := false
            break
          let hs := forceSched h site pf
          let (o', s', ret', slow') ← timedCheck p or hs prop args fuel heap (alts.map (forceSched · site pf)) snap
          runs := runs + 1
          if o'.refutes prop then
            if s'.log.all (·.1 == site) then
              IO.println (report or heap gens args i 0 o' s' ret' p.siteOrigin).compress
              return
            else if fallback.isNone then
              fallback := some (havocReport p or hs prop args fuel heap snap slow' gens i 0 o' s' ret')
          -- A schedule that spins one goroutine out of fuel is one Go's
          -- scheduler does not keep taking: no finding, but no certificate.
          if let .outOfFuel := o' then complete := false
          if o'.moot prop then complete := false
          if s'.log.any (·.1 != site) then other := true
          for a in s'.assumed do
            if !assumed.contains a && assumed.size < 32 then assumed := assumed.push a
          let choices := (Array.range s'.conc.arity.size).map fun k => pf[k]?.getD 0
          pre := nextSched choices s'.conc.arity
        schedRuns := schedRuns + runs
        if !complete then schedSampled := schedSampled + 1
        if !complete || other then havocRuns := havocRuns + 1
    | none => if s.log.size > 0 then havocRuns := havocRuns + 1
    i := i + 1
  if let some j := fallback then
    IO.println (j.setObjVal! "havoc_dependent" true).compress
    return
  IO.println (Json.mkObj (([("found", false), ("exhaustive", fuelOuts == 0 && moots == 0), ("domain", n),
    ("out_of_fuel", fuelOuts), ("moot", moots), ("max_len", maxLen),
    ("havoc_sites", p.havocWidths.size), ("havoc_read", havocRuns),
    ("schedules", schedRuns), ("schedules_sampled", schedSampled), ("setup_snapshot", snapNote)] : List (String × Json)) ++ initNote ++ ([
    ("assumptions", Json.arr (assumed.map Json.str)),
    ("spec_exits", Json.mkObj (exits.map fun (b, n) => (b, (n : Json))))] : List (String × Json)) ++
    loopFields lassoChecked loops loopSites ++ stepFuelFields stepFuel)).compress

end Go2Lean.Search
